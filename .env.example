# Copy to `.env` at the repo root (never commit `.env`).
# Focus uses Qwen (qwen2.5-coder:3b) via local Ollama for Audit Local / CLI audit.
# Topology stays evidence-only; live overlay / autosave never call the model.
# If Ollama is down, Focus keeps deterministic ℹ️ (+ install hint).

# FOCUS_LLM_MODEL=qwen2.5-coder:3b
# FOCUS_LLM_BASE_URL=http://127.0.0.1:11434/v1
# FOCUS_LLM_CONCURRENCY=8
# FOCUS_LLM_SKIP_OLLAMA_INSTALL=1

# Ollama is not bundled. Typical setup:
#   macOS: brew install ollama && brew services start ollama
#   Linux: curl -fsSL https://ollama.com/install.sh | sh
#   Windows: winget install Ollama.Ollama  (or https://ollama.com/download)
#   Then: ollama pull qwen2.5-coder:3b
# Quality fallback if 3B captions feel shallow:
#   ollama pull qwen2.5-coder:7b
#   FOCUS_LLM_MODEL=qwen2.5-coder:7b
# After prompt changes, clear stale captions:
#   python -c "from focus.llm.cache import clear_caption_cache; clear_caption_cache(disk=True)"
# Captions only — never invents dependency edges. See docs/PRIVACY.md.
