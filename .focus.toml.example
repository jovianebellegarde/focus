# Optional Focus config — copy to `.focus.toml` at your repo root.
# Missing file = defaults (fan_out_threshold = 3).

[focus]
# A file becomes a Danger Zone when this many other files import it directly
# (package __init__.py files are never Danger Zones via fan-out alone).
fan_out_threshold = 3

# Opt-in evidence-pack caption labeler (also needs FOCUS_LLM_ENABLED; API key for
# openai/anthropic, or FOCUS_LLM_PROVIDER=ollama for local no-key dogfood).
# Never runs on IDE live-buffer overlay audits.
[llm]
captions = false

# Phase 6 — owner-declared domain labels for the executive summary.
# First matching glob wins. Focus attaches the label to proven blast radius;
# it does not invent business meaning. Omit the section to stay quiet
# (billing/auth danger-path conventions may still hint as a labeled heuristic).
# [domains]
# "billing/**" = "Revenue / charge path"
# "auth/**" = "Auth boundary"
# "api/**" = "Public HTTP surface"
